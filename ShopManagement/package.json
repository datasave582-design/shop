{
  "name": "shop-management",
  "version": "0.2.0",
  "description": "Shop Management / POS / Inventory - Windows desktop app",
  "main": "electron/main.js",
  "author": "Shop Management",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "setup": "npm install && npm --prefix client install",
    "dev:server": "tsx watch server/src/dev.ts",
    "dev:client": "npm --prefix client run dev",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "rebuild:electron": "electron-builder install-app-deps",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "test": "tsx --test server/test/api.test.ts server/test/stock.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "in.shopmanagement.app",
    "productName": "Shop Management",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["electron/**", "server/dist/**", "client/dist/**", "package.json"],
    "asarUnpack": ["**/*.node"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shop Management",
      "artifactName": "ShopManagement-Setup.exe",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "installer/installer.nsh"
    }
  }
}
